# Auto detect text files and perform LF normalization
* text=auto

# Lua and config are always text, always LF
*.lua       text eol=lf
*.json      text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf

# Binaries. Never normalize, never diff.
*.png       binary
*.PNG       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.svg       text eol=lf
*.ogg       binary
*.wav       binary
*.mp3       binary
*.ttf       binary
*.woff      binary
*.woff2     binary

# Collapse vendored UI bundles in pull request diffs
*/html/*.min.js     linguist-vendored
*/html/*.min.css    linguist-vendored

# Same for generated WebUI bundles. The source lives in gns-ui/packages/;
# these are build output, committed so a cloned package runs as-is.
*/html/build/**     linguist-generated

# Git LFS is deliberately NOT enabled. See README for the reasoning. If asset churn
# grows enough to justify it, uncomment these and run `git lfs migrate import`.
# *.png    filter=lfs diff=lfs merge=lfs -text
# *.ogg    filter=lfs diff=lfs merge=lfs -text
