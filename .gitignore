# OS
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.code-workspace

# Secrets — never commit real keys. Keep config.lua values as placeholders.
.env
.env.*
*.key
*.pem
secrets.lua
**/secrets/

# Local scratch
*.log
*.bak
*.tmp
*.orig
*~

# Lua build/tooling
.luarc.json
luacov.*.out

# Node / Bun
# Package bundles under <package>/html/build/ are committed on purpose, so a
# freshly cloned package runs without a build step.
node_modules/
gns-ui/packages/*/dist/
