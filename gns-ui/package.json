{
  "name": "@genesis-rp/shadowglass-ui",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Framework-neutral Shadow Glass WebUI components for Genesis HELIX packages.",
  "type": "module",
  "scripts": {
    "build": "node tooling/build.mjs",
    "sync": "npm run build && node tooling/sync-consumers.mjs",
    "sync:check": "node tooling/sync-consumers.mjs --check",
    "check": "tsc --noEmit && npm run build && npm run sync:check && node --test tests/*.test.mjs",
    "verify:dist": "node tooling/verify-dist.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/exo-2": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "esbuild": "0.28.2",
    "lucide-static": "1.30.0",
    "typescript": "7.0.2"
  },
  "license": "GPL-3.0-only"
}
